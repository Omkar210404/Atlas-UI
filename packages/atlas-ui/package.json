{
  "name": "atlas-ui",
  "version": "0.1.0",
  "description": "An atlas of interfaces: original, accessible React components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
