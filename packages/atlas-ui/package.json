  },
  "scripts": {
    "build": "vite build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "motion": ">=12"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  }
}
